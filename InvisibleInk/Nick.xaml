<Window x:Class="InvisibleInk.Nick"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleInk"
        mc:Ignorable="d"
        Title="Schedule" Height="500" Width="900">
    <Grid Background="#FFEAEAEA" Margin="0,0,0,-65">
        <Label x:Name="FullNameLabel" Content="" HorizontalAlignment="Center" Height="48" Margin="0,10,0,0" VerticalAlignment="Top" Width="831" FontSize="20"/>
        <Button Content="Load" HorizontalAlignment="Left" Margin="682,61,0,0" VerticalAlignment="Top" Height="32" Width="80" Click="Button_Click"/>
        <DataGrid x:Name="DataGrid" HorizontalAlignment="Center" Height="272" Margin="0,158,0,0" VerticalAlignment="Top" Width="833" d:ItemsSource="{d:SampleData}"/>
        <DatePicker x:Name="dtFromDate" HorizontalAlignment="Left" Height="34" Margin="110,62,0,0" VerticalAlignment="Top" Width="222" FirstDayOfWeek="Monday" IsTodayHighlighted="True" SelectedDateFormat="Short" Cursor="AppStarting"/>
        <DatePicker x:Name="dtToDate" HorizontalAlignment="Left" Height="34" Margin="455,60,0,0" VerticalAlignment="Top" Width="222" FirstDayOfWeek="Monday" IsTodayHighlighted="True"/>
        <Label Content="To Date:" HorizontalAlignment="Left" Height="32" Margin="372,62,0,0" VerticalAlignment="Top" Width="78"/>
        <Label Content="From Date:" HorizontalAlignment="Left" Height="31" Margin="27,62,0,0" VerticalAlignment="Top" Width="78" RenderTransformOrigin="0.507,1.211"/>
        <Label x:Name="lblTotal" Content="Total Records: ???" HorizontalAlignment="Left" Height="31" Margin="27,430,0,0" VerticalAlignment="Top" Width="288" RenderTransformOrigin="0.507,1.211" FontWeight="Bold" FontSize="16"/>
        <Button x:Name="btnAllAppointments" Content="All Appointments" HorizontalAlignment="Left" Height="23" Margin="33,130,0,0" VerticalAlignment="Top" Width="151" Click="btnAllAppointments_Click"/>
        <Button x:Name="btnExit" Content="Exit" HorizontalAlignment="Left" Height="32" Margin="826,10,0,0" VerticalAlignment="Top" Width="40" Click="btnExit_Click"/>
        <Button x:Name="AppointmentsForToday" Content="Appointments For Today" HorizontalAlignment="Left" Height="23" Margin="189,130,0,0" VerticalAlignment="Top" Width="151" Click="btnAllAppointmentsForToday_Click"/>
        <Button x:Name="ResetGrid" Content="Reset Grid" HorizontalAlignment="Left" Height="23" Margin="714,130,0,0" VerticalAlignment="Top" Width="152" Click="btnResetGrid_Click"/>

    </Grid>
</Window>
