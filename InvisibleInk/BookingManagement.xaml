<Window x:Class="InvisibleInk.BookingManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleInk"
        mc:Ignorable="d"
        Title="Booking Management" Height="450" Width="831">
    <Grid Background="#FFEAEAEA" Margin="0,0,0,-112" RenderTransformOrigin="0.499,0.258">
        <Grid.ColumnDefinitions>

        </Grid.ColumnDefinitions>
        <DataGrid x:Name="DataGrid" Height="207" Margin="10,334,0,0" VerticalAlignment="Top" Width="811" d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2"/>
        <Button Content="Update" HorizontalAlignment="Left" Height="30" Margin="454,299,0,0" VerticalAlignment="Top" Width="109" Background="#FFFDB4B4" Click="Button_Click"/>
        <Button Content="Delete" HorizontalAlignment="Left" Height="30" Margin="588,299,0,0" VerticalAlignment="Top" Width="109" Background="#FFCE1B1B" Click="Button_Click_1"/>
        <Button Content="Search" HorizontalAlignment="Left" Height="30" Margin="717,299,0,0" VerticalAlignment="Top" Width="109" Background="#FF34B56B" Click="Button_Click_2"/>
        <Label Content="Please Note You Can't Insert Bookings Here" HorizontalAlignment="Left" Height="30" Margin="15,296,0,0" VerticalAlignment="Top" Width="321"/>
        <TextBox x:Name="ClientName" HorizontalAlignment="Left" Height="29" Margin="157,109,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182"/>
        <TextBox x:Name="date" HorizontalAlignment="Left" Height="28" Margin="519,75,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2"/>
        <TextBox x:Name="BookingRef" HorizontalAlignment="Left" Height="29" Margin="157,75,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182"/>
        <Label Content="Booking Management" HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="355" FontSize="16"/>
        <TextBox x:Name="DepositPaid" HorizontalAlignment="Left" Height="30" Margin="519,177,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2"/>
        <TextBox x:Name="NewClient" HorizontalAlignment="Left" Height="28" Margin="519,143,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2"/>
        <TextBox x:Name="AssighnedStaffMember" HorizontalAlignment="Left" Height="30" Margin="519,109,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182" Grid.ColumnSpan="2"/>
        <TextBox x:Name="timeday" HorizontalAlignment="Left" Height="28" Margin="158,211,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182"/>
        <TextBox x:Name="PiercingName" HorizontalAlignment="Left" Height="28" Margin="157,143,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="183"/>
        <TextBox x:Name="whofor" HorizontalAlignment="Left" Height="28" Margin="158,176,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="182"/>
        <Label x:Name="FullNameLabel" Content="" HorizontalAlignment="Right" Height="40" Margin="0,14,97,0" VerticalAlignment="Top" Width="236"/>
        <Button Content="Exit" HorizontalAlignment="Left" Margin="747,15,0,0" VerticalAlignment="Top" Height="30" Width="74" Click="Button_Click_3"/>
        <Label x:Name="Booking_Reference" Content="Booking Reference" HorizontalAlignment="Left" Height="29" Margin="33,75,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy" Content="Piercing" HorizontalAlignment="Left" Height="29" Margin="33,144,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy1" Content="Who Is It For" HorizontalAlignment="Left" Height="29" Margin="33,178,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy2" Content="Time" HorizontalAlignment="Left" Height="29" Margin="33,211,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy3" Content="Client Name" HorizontalAlignment="Left" Height="29" Margin="33,110,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy4" Content="Date" HorizontalAlignment="Left" Height="28" Margin="395,75,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy5" Content="Staff Member" HorizontalAlignment="Left" Height="28" Margin="395,110,0,0" VerticalAlignment="Top" Width="119" RenderTransformOrigin="0.504,2.035"/>
        <Label x:Name="Booking_Reference_Copy6" Content="New Client" HorizontalAlignment="Left" Height="28" Margin="395,146,0,0" VerticalAlignment="Top" Width="119"/>
        <Label x:Name="Booking_Reference_Copy7" Content="Deposit Paid" HorizontalAlignment="Left" Height="28" Margin="395,179,0,0" VerticalAlignment="Top" Width="119"/>
        <Label Content="You Can Making Changes To A Booking On The System" HorizontalAlignment="Left" Height="25" Margin="15,45,0,0" VerticalAlignment="Top" Width="324"/>

    </Grid>
</Window>
