<Window x:Class="InvisibleInk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InvisibleInk"
        mc:Ignorable="d"
        Title="Welcome" Height="450" Width="800">
    <Grid Background="#FFEAEAEA">
        <TextBox x:Name="UserIdTextBox" HorizontalAlignment="Center" Height="48" Margin="0,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="304"/>
        <Button x:Name="btnLogin" Content="Login" HorizontalAlignment="Left" Height="38" Margin="312,254,0,0" VerticalAlignment="Top" Width="170" Click="LoginButton_Click"/>
        <Image HorizontalAlignment="Left" Height="176" Margin="315,10,0,0" VerticalAlignment="Top" Width="167" Source="/invisibleink.png">
            <Image.OpacityMask>
                <ImageBrush ImageSource="/invisibleink.png"/>
            </Image.OpacityMask>
        </Image>
        <Label Content="Welcome to Invisible Ink Please Login" HorizontalAlignment="Center" Height="35" Margin="0,168,0,0" VerticalAlignment="Top" Width="224" FontStyle="Italic"/>

    </Grid>
</Window>
